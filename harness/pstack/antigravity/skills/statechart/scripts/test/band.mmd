---
title: "An edge into a group from above"
---
stateDiagram-v2
  state "Outside" as a
  state "A group" as G {
    state "Inside one" as i1
    state "Inside two" as i2
    i1 --> i2 : go
  }
  state "After" as b
  [*] --> a
  a --> G : into the group
  G --> b : out of the group
  a --> i2 : straight to a child
