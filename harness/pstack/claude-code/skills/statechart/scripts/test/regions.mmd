---
title: "Parcel and payment"
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef plain fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef plainWrong fill:#f4f6f7,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Wrong fill:#d6eaf8,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef group1 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  state "Legend" as legend {
    state "Card on file" as legendGroup0
    state "No card yet" as legendGroup1
    state "Breaks a rule" as legendWrong
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendWrong plainWrong
  state "At the same time" as regions {
    state "The parcel" as region0 {
      [*] --> r0s0
      state "Label printed" as r0s0
      state "In transit" as r0s1
      state "Out for delivery" as r0s2
      state "Left at the front door<br/>without a signature" as r0s3
      state "Held at the depot after<br/>a missed delivery" as r0s4
      state "Sent back to the shop" as r0s5
      r0s0 --> r0s1 : the courier scans the label<br/>at the depot
      r0s1 --> r0s2 : the van leaves the depot with<br/>the parcel on board
      r0s2 --> r0s3 : the courier leaves the parcel<br/>at the door [when charged<br/>once]
      r0s2 --> r0s4 : nobody answers the door<br/>before the van moves on
      r0s4 --> r0s2 : the depot books a second<br/>delivery for the next day
      r0s4 --> r0s5 : the parcel waits at the depot<br/>for more than fourteen days
    }
    --
    state "Payment" as region1 {
      [*] --> r1s0
      state "No card on file" as r1s0
      state "Card saved, waiting<br/>for the charge" as r1s1
      state "Charged once" as r1s2
      state "Charged twice for<br/>one parcel" as r1s3
      state "Refund sent while the<br/>parcel was on the doorstep" as r1s4
      r1s0 --> r1s1 : you save a card on the<br/>checkout page
      r1s1 --> r1s2 : the bank approves the charge<br/>for the parcel
      r1s2 --> r1s3 : the payment service retries<br/>a charge that went through
      r1s2 --> r1s4 : the shop sends a refund before<br/>the parcel comes back [when<br/>left at the front door]
    }
  }
  class r0s0 group1
  class r0s1 plain
  class r0s2 plain
  class r0s3 plainWrong
  class r0s4 plain
  class r0s5 plain
  class r1s0 group1
  class r1s1 group0
  class r1s2 group0
  class r1s3 group0Wrong
  class r1s4 group0Wrong
