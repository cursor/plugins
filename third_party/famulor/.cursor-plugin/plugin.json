{
  "name": "famulor",
  "displayName": "Famulor",
  "version": "1.0.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Build and run AI phone assistants, calls, campaigns, and WhatsApp agents.",
  "author": {
    "name": "Famulor",
    "email": "sales@famulor.io"
  },
  "homepage": "https://www.famulor.io",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "famulor",
    "voice ai",
    "voice agent",
    "phone assistant",
    "ai receptionist",
    "calls",
    "campaigns",
    "whatsapp",
    "webchat",
    "knowledge base",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "famulor",
    "voice-ai",
    "calls",
    "mcp"
  ],
  "variables": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "FAMULOR_API_KEY"
    ],
    "properties": {
      "FAMULOR_API_KEY": {
        "type": "string",
        "title": "Famulor API key",
        "description": "Workspace API key (starts with fam_) from app.famulor.io under Settings → API & MCP → Create a new API key.",
        "writeOnly": true,
        "format": "password"
      }
    }
  },
  "mcpServers": "./mcp.json"
}
