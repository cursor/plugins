{
  "name": "databricks-genie-one",
  "displayName": "Databricks Genie One",
  "version": "1.0.1",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Ask Databricks Genie questions about your workspace's data in plain language.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://github.com/cursor/plugins/tree/main/third_party/databricks-genie-one",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "databricks",
    "genie",
    "genie one",
    "data",
    "analytics",
    "sql",
    "lakehouse",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "databricks",
    "data",
    "analytics",
    "mcp"
  ],
  "variables": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "DATABRICKS_HOST",
      "CLIENT_ID"
    ],
    "properties": {
      "DATABRICKS_HOST": {
        "type": "string",
        "title": "Workspace hostname",
        "description": "For example, dbc-a1b2c3d4-e5f6.cloud.databricks.com"
      },
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID"
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "writeOnly": true,
        "format": "password"
      }
    }
  },
  "mcpServers": "./mcp.json"
}
