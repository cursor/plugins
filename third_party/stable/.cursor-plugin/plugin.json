{
  "name": "stable",
  "displayName": "Stable",
  "version": "1.0.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Find mail, read scanned documents, and call Stable API endpoints.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://usestable.com",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "stable",
    "mail",
    "virtual mailbox",
    "documents",
    "scans",
    "api",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "stable",
    "mail",
    "documents",
    "mcp"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "STABLE_API_KEY": {
        "type": "string",
        "title": "Stable API key",
        "description": "API key from the Stable dashboard (https://dashboard.usestable.com/settings/api-keys)."
      }
    },
    "required": [
      "STABLE_API_KEY"
    ]
  },
  "mcpServers": "./mcp.json"
}
