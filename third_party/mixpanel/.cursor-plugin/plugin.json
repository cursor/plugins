{
  "name": "mixpanel",
  "displayName": "Mixpanel",
  "version": "1.1.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Query events, funnels, flows, and retention in Mixpanel, and manage dashboards, cohorts, experiments, and feature flags.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://docs.mixpanel.com/docs/mcp",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "mixpanel",
    "product analytics",
    "funnels",
    "retention",
    "dashboards",
    "cohorts",
    "experiments",
    "feature flags",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "mixpanel",
    "analytics",
    "mcp"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "MIXPANEL_MCP_HOST": {
        "type": "string",
        "title": "Mixpanel region",
        "description": "The MCP host for your Mixpanel data region: mcp.mixpanel.com (United States), mcp-eu.mixpanel.com (Europe), or mcp-in.mixpanel.com (India).",
        "enum": [
          "mcp.mixpanel.com",
          "mcp-eu.mixpanel.com",
          "mcp-in.mixpanel.com"
        ]
      }
    }
  },
  "mcpServers": "./mcp.json"
}
