stateDiagram-v2
  state "Nothing chosen" as Idle
  state "Uploading" as Uploading {
    state "Sending the file" as Sending
    state "Checking the file" as Checking
    [*] --> Sending
    Sending --> Checking : the last byte arrives
  }
  state "Uploaded" as Done
  state "Upload failed" as Failed
  [*] --> Idle
  Idle --> Uploading : you choose a file
  Checking --> Done : the check passes
  Uploading --> Failed : the network drops
  Failed --> Uploading : you retry
  Uploading --> Idle : you cancel
